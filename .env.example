APP_NAME=Event-Driven Order Orchestration System
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://orders:orders@postgres:5432/orders
TEST_DATABASE_URL=sqlite:///./test_order_processing.db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
LOG_LEVEL=INFO
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_RETENTION_DAYS=7
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_MAX=60
FAILURE_INJECTION_ENABLED=false
FAILURE_TRANSIENT_ATTEMPTS=2
API_PORT=8000
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
TRACKING_TOKEN_SECRET=local-tracking-token-secret-change-me
PUBLIC_TRACKING_BASE_URL=http://localhost:8000
PUBLIC_TRACKING_SHOW_TOTAL=false
NOTIFICATIONS_BACKEND=console
NOTIFICATIONS_ALLOW_CONSOLE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false
# Set SMTP_USERNAME/SMTP_PASSWORD through private environment configuration.
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_INTERVAL_SECONDS=10
# Use manual outside local/development/test; new tenants snapshot this default.
# Seller webhook deliveries: strict HTTPS/public targets by default.
WEBHOOK_ALLOW_INSECURE_TARGETS=false
WEBHOOK_EXTRA_ALLOWED_PORTS=[]
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_RESPONSE_MAX_BYTES=1024
WEBHOOK_RETRY_BASE_SECONDS=600
WEBHOOK_RETRY_MAX_SECONDS=43200
WEBHOOK_DISABLE_AFTER_FAILURES=20
WEBHOOK_DELIVERY_INTERVAL_SECONDS=10
WEBHOOK_DELIVERY_BATCH_SIZE=100
WEBHOOK_LEASE_SECONDS=60
ALLOW_MOCK_PROVIDERS=true
MOCK_PAYMENT_AUTO_COMPLETE=true
MOCK_REFUND_FAIL_ATTEMPTS=0
PAYMENT_WINDOW_SECONDS=1800
REFUND_LEASE_SECONDS=60
# MOCK_WEBHOOK_SECRET is a local simulator secret. Supply it from a secret store outside local use.
PROCESSED_EVENTS_RETENTION_DAYS=30
# Shared fixed-window quotas (use a separate Redis logical DB from Celery).
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_EMAIL_LIMIT=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_LIMIT=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_AUTHENTICATED_LIMIT=600
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_LIMIT=600
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_LIMIT=600
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# Reserved for Part 2; no tracking/SSE route is added here.
RATE_LIMIT_TRACKING_LIMIT=60
RATE_LIMIT_TRACKING_WINDOW_SECONDS=60
SSE_TENANT_CONNECTION_LIMIT=10
SSE_IP_CONNECTION_LIMIT=5
REGISTRATION_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_UNMATCHED_RETRY_SECONDS=600
PAYMENT_CAPTURE_GRACE_SECONDS=120
PAYMENT_EXPIRY_INTERVAL_SECONDS=30
PAYMENT_MAINTENANCE_BATCH_SIZE=100
PAYMENT_RECONCILE_AFTER_SECONDS=60
PAYMENT_RECONCILE_INTERVAL_SECONDS=60
PAYMENT_RECONCILE_LEASE_SECONDS=60
# CREDENTIALS_ENCRYPTION_KEY: secret Fernet key(s), newest first, comma-separated; never commit a value.
# REGISTRATION_INVITE_CODE is optional; store it outside source control.
