{
  "name": "seller-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node --require ./scripts/ingress.cjs node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "node scripts/generate-api.mjs",
    "gen:api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.74.0",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0"
  },
  "type": "module"
}
